NEXT_PUBLIC_SUPABASE_URL=
# Clave pública sb_publishable_... para clientes públicos y sesiones con RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave sb_secret_... exclusivamente del servidor/importador privado. Nunca NEXT_PUBLIC.
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# URL de estilo vectorial MapLibre. {key} se reemplaza por la clave pública.
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_TILE_PROVIDER_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
GEOREF_API_URL=https://apis.datos.gob.ar/georef/api/v2.0
# Configurar proveedor Photon propio/contratado para producción. Vacío: solo Georef/manual.
PHOTON_API_URL=
# Salt aleatorio para hashes del limitador de peticiones.
RATE_LIMIT_SALT=
